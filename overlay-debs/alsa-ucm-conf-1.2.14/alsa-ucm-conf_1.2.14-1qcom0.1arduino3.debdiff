diff -Nru alsa-ucm-conf-1.2.14/debian/remoteproc_audio_fixup.service alsa-ucm-conf-1.2.14/debian/remoteproc_audio_fixup.service
--- alsa-ucm-conf-1.2.14/debian/remoteproc_audio_fixup.service	1970-01-01 00:00:00.000000000 +0000
+++ alsa-ucm-conf-1.2.14/debian/remoteproc_audio_fixup.service	2026-05-07 21:01:19.000000000 +0000
@@ -0,0 +1,10 @@
+[Unit]
+Description=Restarts remoteproc if audio load is failing
+Before=sound.target
+
+[Service]
+Type=oneshot
+ExecStart=/opt/arduino/scripts/restart_remoteproc_audio.sh
+
+[Install]
+WantedBy=basic.target
diff -Nru alsa-ucm-conf-1.2.14/debian/scripts/restart_remoteproc_audio.sh alsa-ucm-conf-1.2.14/debian/scripts/restart_remoteproc_audio.sh
--- alsa-ucm-conf-1.2.14/debian/scripts/restart_remoteproc_audio.sh	1970-01-01 00:00:00.000000000 +0000
+++ alsa-ucm-conf-1.2.14/debian/scripts/restart_remoteproc_audio.sh	2026-05-07 21:02:13.000000000 +0000
@@ -0,0 +1,18 @@
+#!/bin/bash
+
+handle_no_soundcard() {
+    logger -t remoteproc-check "No sound cards found via alsaucm. Attempting remoteproc restart..."
+    if grep -q "running" /sys/class/remoteproc/remoteproc1/state; then
+        logger -t remoteproc-check "Remoteproc is currently running. Stopping it before restart."
+        echo stop > /sys/class/remoteproc/remoteproc1/state
+    else
+    echo -n qcom/qcm2290/adsp.mbn > /sys/class/remoteproc/remoteproc1/firmware
+    fi
+    echo start > /sys/class/remoteproc/remoteproc1/state
+}
+
+if alsaucm listcards 2>/dev/null | grep -q "list is empty"; then
+    handle_no_soundcard
+else
+    logger -t remoteproc-check "Sound cards found via alsaucm. No need to restart remoteproc."
+fi
\ No newline at end of file
