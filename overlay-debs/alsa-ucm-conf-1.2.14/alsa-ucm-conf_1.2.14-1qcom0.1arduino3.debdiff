++	}
++}
++
++SectionDevice."LineOut" {
++	Comment "Lineout playback"
++
++	Include.wcdhpe.File "/codecs/pm4125/LineoutEnableSeq.conf"
++	Include.wcdhpd.File "/codecs/pm4125/LineoutDisableSeq.conf"
++	Include.rxmhpe.File "/codecs/qcom-lpass/rx-macro/HeadphoneLEnableSeq.conf"
++	Include.rxmhpd.File "/codecs/qcom-lpass/rx-macro/HeadphoneLDisableSeq.conf"
++
++	Value {
++		PlaybackPriority 200
++		PlaybackPCM "hw:${CardId},1"
++		PlaybackMixer "hw:${CardId}"
++	}
++}
+Index: alsa-ucm-conf-1.2.14/ucm2/Qualcomm/qcm2290/qcm2290.conf
+===================================================================
+--- /dev/null
++++ alsa-ucm-conf-1.2.14/ucm2/Qualcomm/qcm2290/qcm2290.conf
+@@ -0,0 +1,12 @@
++Syntax 4
++
++Define.DMI_info "${sys:devices/virtual/dmi/id/board_vendor}-${sys:devices/virtual/dmi/id/product_name}-${sys:devices/virtual/dmi/id/board_name}"
++
++If.ArduinoImola {
++	Condition {
++		Type RegexMatch
++		String "${var:DMI_info}"
++		Regex "arduino-Imola*"
++	}
++	True.Include.imola.File "/Qualcomm/qcm2290/Arduino-Imola.conf"
++}
